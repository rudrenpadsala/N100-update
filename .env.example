# =================================================================
# Angel One SmartAPI Configuration
# =================================================================
# SmartAPI API Key generated from https://smartapi.angelone.in/
ANGEL_API_KEY=your_smartapi_api_key_here

# Angel One Client ID / User Code (e.g. A123456)
ANGEL_CLIENT_CODE=your_client_code_here

# Angel One Account MPIN / Password
ANGEL_PIN=your_mpin_here

# Angel One Authenticator TOTP Secret Key (from 2FA setup in Angel One / Google Authenticator)
ANGEL_TOTP_KEY=your_totp_secret_key_here

# Market Data Polling Interval in seconds (default: 15)
ANGEL_POLL_INTERVAL=15

# Optional Project Configuration
PROJECT_NAME=NIFTY-100-FINANCIAL-INTELLIGENCE-PLATFORM
